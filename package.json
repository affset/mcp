{
  "name": "@affset/mcp",
  "version": "0.1.3",
  "mcpName": "io.github.affset/mcp",
  "description": "MCP server for the affset ad platform — stats, campaigns, zones, payouts, targeting, sub labels, and team from your chat client.",
  "type": "module",
  "license": "MIT",
  "author": "Elusione OÜ",
  "homepage": "https://github.com/affset/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affset/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/affset/mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "affset-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && cd dist && node --test",
    "check-all": "npm run lint && npm run format:check && npm run type-check && npm test",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "affset",
    "ad-server",
    "media-buying"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "minimatch": {
      "brace-expansion": "^5.0.8"
    }
  }
}
